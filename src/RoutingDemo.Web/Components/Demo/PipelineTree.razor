@using RoutingDemo.Web.Demo

<div class="pipeline-tree @(Compact ? "compact" : null) @(Interactive ? "interactive" : null)"
     role="tree"
     aria-label="Routing client composition">
    @if (Configuration.GlobalFallbackEnabled)
    {
        string outerKey = "outer";
        string globalKey = $"global:{Configuration.GlobalFallback.Id}";

        <button class="@NodeClass(outerKey, "tree-node root outer")"
                type="button"
                role="treeitem"
                disabled="@(!Interactive)"
                aria-pressed="@(SelectedNodeKey == outerKey)"
                @onclick="() => SelectNodeAsync(outerKey)">
            <span class="node-glyph">OF</span>
            <span class="node-copy">
                <strong>OrderedFailoverChatClient</strong>
                <small>Whole-pipeline emergency fallback</small>
            </span>
            <span class="node-kind">outer</span>
        </button>

        <div class="tree-branch root-branch">
            <div class="tree-subtree">
                @RenderSelectorNode()
                @if (IsStickySemantic)
                {
                    <div class="tree-branch sticky-classifier-branch">
                        @RenderSemanticClassifierNode()
                        @RenderFamilies()
                    </div>
                }
                else
                {
                    @RenderFamilies()
                }
            </div>

            <button class="@NodeClass(globalKey, "tree-node route global-fallback")"
                    type="button"
                    role="treeitem"
                    disabled="@(!Interactive)"
                    aria-pressed="@(SelectedNodeKey == globalKey)"
                    @onclick="() => SelectNodeAsync(globalKey)">
                <span class="route-dot emergency @GetRouteStatusClass(Configuration.GlobalFallback)"></span>
                <span class="node-copy">
                    <strong>@Configuration.GlobalFallback.Name</strong>
                    <small>@Configuration.GlobalFallback.ModelId</small>
                </span>
                <span class="tree-tag">emergency</span>
            </button>
        </div>
    }
    else
    {
        @RenderSelectorNode(isRoot: true)
        @if (IsStickySemantic)
        {
            <div class="tree-branch sticky-classifier-branch">
                @RenderSemanticClassifierNode()
                @RenderFamilies()
            </div>
        }
        else
        {
            @RenderFamilies()
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public PipelineConfiguration Configuration { get; set; } = null!;

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public bool Interactive { get; set; }

    [Parameter]
    public string SelectedNodeKey { get; set; } = "selector";

    [Parameter]
    public string? PinnedFamilyId { get; set; }

    [Parameter]
    public EventCallback<string> SelectedNodeKeyChanged { get; set; }

    private RenderFragment RenderSelectorNode(bool isRoot = false) => builder =>
    {
        string key = "selector";
        string classes = NodeClass(key, $"tree-node selector {(isRoot ? "root" : null)}");
        string glyph = Configuration.SelectionPolicy switch
        {
            "StickySemantic" => "ST",
            "Semantic" => "SR",
            _ => "DR",
        };
        string name = Configuration.SelectionPolicy switch
        {
            "StickySemantic" => "StickySemanticRoutingChatClient",
            "Semantic" => "SemanticRoutingChatClient",
            _ => "Direct route",
        };
        string description = Configuration.SelectionPolicy switch
        {
            "StickySemantic" => "Session ID cache / pin after completion",
            "Semantic" => $"Top {Configuration.TopK} / {Configuration.ScoreAggregation} / threshold {Configuration.ScoreThreshold:0.00}",
            _ => "One route family",
        };

        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "class", classes);
        builder.AddAttribute(2, "type", "button");
        builder.AddAttribute(3, "role", "treeitem");
        builder.AddAttribute(4, "disabled", !Interactive);
        builder.AddAttribute(5, "aria-pressed", SelectedNodeKey == key);
        builder.AddAttribute(6, "onclick", EventCallback.Factory.Create(this, () => SelectNodeAsync(key)));
        builder.OpenElement(7, "span");
        builder.AddAttribute(8, "class", "node-glyph selector-glyph");
        builder.AddContent(9, glyph);
        builder.CloseElement();
        builder.OpenElement(10, "span");
        builder.AddAttribute(11, "class", "node-copy");
        builder.OpenElement(12, "strong");
        builder.AddContent(13, name);
        builder.CloseElement();
        builder.OpenElement(14, "small");
        builder.AddContent(15, description);
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(16, "span");
        builder.AddAttribute(17, "class", "node-kind");
        builder.AddContent(18, "selector");
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderSemanticClassifierNode() => builder =>
    {
        const string key = "classifier";
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "class", NodeClass(key, "tree-node selector semantic-classifier"));
        builder.AddAttribute(2, "type", "button");
        builder.AddAttribute(3, "role", "treeitem");
        builder.AddAttribute(4, "disabled", !Interactive);
        builder.AddAttribute(5, "aria-pressed", SelectedNodeKey == key);
        builder.AddAttribute(6, "onclick", EventCallback.Factory.Create(this, () => SelectNodeAsync(key)));
        builder.OpenElement(7, "span");
        builder.AddAttribute(8, "class", "node-glyph selector-glyph");
        builder.AddContent(9, "SR");
        builder.CloseElement();
        builder.OpenElement(10, "span");
        builder.AddAttribute(11, "class", "node-copy");
        builder.OpenElement(12, "strong");
        builder.AddContent(13, "SemanticRoutingChatClient");
        builder.CloseElement();
        builder.OpenElement(14, "small");
        builder.AddContent(
            15,
            $"First unpinned turn / top {Configuration.TopK} / threshold {Configuration.ScoreThreshold:0.00}");
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(16, "span");
        builder.AddAttribute(17, "class", "node-kind");
        builder.AddContent(18, "classifier");
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderFamilies() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "tree-branch family-branch");

        int sequence = 2;
        foreach (RouteFamilyDefinition family in Configuration.Families)
        {
            string familyKey = $"family:{family.Id}";
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "tree-subtree family-subtree");

            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "class", NodeClass(familyKey, "tree-node family"));
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "role", "treeitem");
            builder.AddAttribute(sequence++, "disabled", !Interactive);
            builder.AddAttribute(sequence++, "aria-pressed", SelectedNodeKey == familyKey);
            builder.AddAttribute(
                sequence++,
                "onclick",
                EventCallback.Factory.Create(this, () => SelectNodeAsync(familyKey)));
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "family-glyph");
            builder.AddContent(sequence++, FamilyMonogram(family.Name));
            builder.CloseElement();
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "node-copy");
            builder.OpenElement(sequence++, "strong");
            builder.AddContent(sequence++, family.Name);
            builder.CloseElement();
            builder.OpenElement(sequence++, "small");
            builder.AddContent(
                sequence++,
                IsSemanticSelection
                    ? $"{family.Purpose} semantic profile"
                    : family.Purpose);
            builder.CloseElement();
            builder.CloseElement();
            if (family.Id == PinnedFamilyId)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "tree-tag pinned");
                builder.AddContent(sequence++, "pinned");
                builder.CloseElement();
            }
            else if (family.IsDefault)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "tree-tag");
                builder.AddContent(sequence++, "default");
                builder.CloseElement();
            }

            builder.CloseElement();

            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "tree-branch target-branch");

            if (family.ResiliencePolicy != "None")
            {
                string policyKey = $"policy:{family.Id}";
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "tree-subtree policy-subtree");
                builder.OpenElement(sequence++, "button");
                builder.AddAttribute(sequence++, "class", NodeClass(policyKey, "tree-node policy"));
                builder.AddAttribute(sequence++, "type", "button");
                builder.AddAttribute(sequence++, "role", "treeitem");
                builder.AddAttribute(sequence++, "disabled", !Interactive);
                builder.AddAttribute(sequence++, "aria-pressed", SelectedNodeKey == policyKey);
                builder.AddAttribute(
                    sequence++,
                    "onclick",
                    EventCallback.Factory.Create(this, () => SelectNodeAsync(policyKey)));
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "node-glyph policy-glyph");
                builder.AddContent(sequence++, family.ResiliencePolicy == "Cooldown" ? "CD" : "OF");
                builder.CloseElement();
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "node-copy");
                builder.OpenElement(sequence++, "strong");
                builder.AddContent(
                    sequence++,
                    family.ResiliencePolicy == "Cooldown"
                        ? "CooldownFailoverChatClient"
                        : "OrderedFailoverChatClient");
                builder.CloseElement();
                builder.OpenElement(sequence++, "small");
                builder.AddContent(
                    sequence++,
                    family.ResiliencePolicy == "Cooldown"
                        ? $"{family.CooldownSeconds}s cooldown / max {family.MaximumAttempts} attempts"
                        : $"Static order / max {family.MaximumAttempts} attempts");
                builder.CloseElement();
                builder.CloseElement();
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "node-kind");
                builder.AddContent(sequence++, "resilience");
                builder.CloseElement();
                builder.CloseElement();

                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "tree-branch model-branch");
                RenderRoutes(builder, family, ref sequence);
                builder.CloseElement();
                builder.CloseElement();
            }
            else
            {
                RenderRoutes(builder, family, ref sequence);
            }

            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private void RenderRoutes(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        RouteFamilyDefinition family,
        ref int sequence)
    {
        foreach (RouteDefinition route in family.Routes)
        {
            string routeKey = $"route:{family.Id}:{route.Id}";
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "class", NodeClass(routeKey, "tree-node route"));
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "role", "treeitem");
            builder.AddAttribute(sequence++, "disabled", !Interactive);
            builder.AddAttribute(sequence++, "aria-pressed", SelectedNodeKey == routeKey);
            builder.AddAttribute(
                sequence++,
                "onclick",
                EventCallback.Factory.Create(this, () => SelectNodeAsync(routeKey)));
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", $"route-dot {GetRouteStatusClass(route)}");
            builder.CloseElement();
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "node-copy");
            builder.OpenElement(sequence++, "strong");
            builder.AddContent(sequence++, route.Name);
            builder.CloseElement();
            builder.OpenElement(sequence++, "small");
            builder.AddContent(sequence++, $"{route.ModelId} / {ToTitle(route.ReasoningEffort)} reasoning");
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
        }
    }

    private string NodeClass(string key, string classes) =>
        $"{classes} {(Interactive && SelectedNodeKey == key ? "selected" : null)}";

    private bool IsStickySemantic => Configuration.SelectionPolicy == "StickySemantic";

    private bool IsSemanticSelection =>
        Configuration.SelectionPolicy is "Semantic" or "StickySemantic";

    private async Task SelectNodeAsync(string key)
    {
        if (!Interactive)
        {
            return;
        }

        SelectedNodeKey = key;
        await SelectedNodeKeyChanged.InvokeAsync(key);
    }

    private static string FamilyMonogram(string value)
    {
        string[] words = value.Split([' ', '-', '_'], StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0)
        {
            return "RF";
        }

        return string.Concat(words.Take(2).Select(word => char.ToUpperInvariant(word[0])));
    }

    private static string ToTitle(string value) =>
        string.IsNullOrWhiteSpace(value)
            ? value
            : char.ToUpperInvariant(value[0]) + value[1..];

    private static string GetRouteStatusClass(RouteDefinition route)
    {
        DateTimeOffset now = DateTimeOffset.Now;
        if (route.DownUntilRevived ||
            route.PolicyDisabled ||
            route.DownUntil is { } downUntil && downUntil > now)
        {
            return "down";
        }

        if (route.CooldownUntil is { } cooldownUntil && cooldownUntil > now)
        {
            return "cooling";
        }

        return route.FailNext ? "armed" : "healthy";
    }
}
