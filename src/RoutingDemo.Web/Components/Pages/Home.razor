@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using RoutingDemo.Web.Demo

<PageTitle>Routing AI Chat Demo</PageTitle>

<div class="demo-shell">
    <header class="topbar">
        <button class="brand" type="button" @onclick="GoHome" aria-label="Routing AI demo home">
            <span class="brand-mark">R</span>
            <span>
                <strong>routing.ai</strong>
                <small>Microsoft.Extensions.AI</small>
            </span>
        </button>

        @if (IsBuilt)
        {
            <div class="topbar-pipeline">
                <span class="live-dot"></span>
                <span>@ActiveConfiguration!.ScenarioName</span>
                <span class="topbar-separator">/</span>
                <span>@GetCompositionLabel(ActiveConfiguration)</span>
            </div>

            <button class="button button-quiet" type="button" @onclick="RebuildPipeline">
                Rebuild pipeline
            </button>
        }
        else
        {
            <span class="prototype-badge">Interactive prototype</span>
        }
    </header>

    @if (!IsBuilt)
    {
        <main class="builder-page live-builder-page">
            <section class="builder-intro live-builder-intro">
                <div>
                    <span class="eyebrow">Extensible routing playground</span>
                    <h1>Build the routing tree.</h1>
                </div>
                <p>
                    Pick a preset or node. The tree updates live.
                </p>
            </section>

            <section class="preset-strip">
                <div class="preset-strip-heading">
                    <span class="eyebrow">Preset</span>
                </div>
                <div class="preset-options">
                    @foreach (ScenarioDefinition scenario in Scenarios)
                    {
                        <button class="preset-option @(Draft.ScenarioId == scenario.Id ? "selected" : null)"
                                type="button"
                                title="@scenario.Description"
                                @onclick="() => SelectScenario(scenario.Id)">
                            <span class="preset-monogram">@GetScenarioMonogram(scenario.Id)</span>
                            <span>
                                <strong>@scenario.Name</strong>
                                <small>@scenario.Composition</small>
                            </span>
                        </button>
                    }
                </div>
            </section>

            <section class="builder-card live-builder-card">
                        <div class="section-heading tree-step-heading">
                            <div>
                                <span class="eyebrow">Live composition</span>
                                <h2>@Draft.ScenarioName</h2>
                            </div>
                            <div class="tree-step-actions">
                                <label class="streaming-toggle compact-toggle">
                                    <input type="checkbox" @bind="Draft.Streaming" />
                                    <span class="toggle-track"><span></span></span>
                                    <span>
                                        <strong>Streaming</strong>
                                    </span>
                                </label>
                                <button class="button button-secondary" type="button" @onclick="AddFamily">
                                    Add route family
                                </button>
                            </div>
                        </div>

                        <div class="composition-editor live-composition-editor">
                            <section class="tree-canvas">
                                <header class="tree-canvas-header">
                                    <div>
                                        <strong>Pipeline</strong>
                                    </div>
                                </header>

                                <div class="interactive-tree-scroll">
                                    <PipelineTree Configuration="Draft"
                                                  Interactive="true"
                                                  @bind-SelectedNodeKey="SelectedNodeKey" />
                                </div>

                            </section>

                            <section class="node-inspector">
                                <header class="node-inspector-header">
                                    <span class="node-type-label">@GetSelectedNodeType()</span>
                                    <h3>@GetSelectedNodeTitle()</h3>
                                </header>

                                @if (SelectedNodeKey is "selector" or "outer")
                                {
                                    <div class="inspector-fields">
                                        <label>
                                            <span>Selection policy</span>
                                            <select value="@Draft.SelectionPolicy"
                                                    @onchange="OnSelectionChanged">
                                                <option>Semantic</option>
                                                <option value="StickySemantic">Sticky semantic</option>
                                                <option value="Direct" disabled="@(Draft.Families.Count != 1)">Direct</option>
                                            </select>
                                            @if (Draft.Families.Count != 1)
                                            {
                                                <small class="field-help constraint-help">
                                                    Direct requires exactly one route family.
                                                </small>
                                            }
                                        </label>

                                        @if (UsesSemanticSelection(Draft.SelectionPolicy))
                                        {
                                            <div class="inspector-grid three">
                                                <label>
                                                    <span>Threshold</span>
                                                    <input type="number" min="0" max="1" step="0.05"
                                                           @bind="Draft.ScoreThreshold" />
                                                </label>
                                                <label>
                                                    <span>Top K</span>
                                                    <select @bind="Draft.TopK">
                                                        <option value="1">1</option>
                                                        <option value="3">3</option>
                                                        <option value="5">5</option>
                                                    </select>
                                                </label>
                                                <label>
                                                    <span>Aggregation</span>
                                                    <select @bind="Draft.ScoreAggregation">
                                                        <option>Mean</option>
                                                        <option>Sum</option>
                                                    </select>
                                                </label>
                                            </div>

                                            @if (Draft.SelectionPolicy == "StickySemantic")
                                            {
                                                <div class="sticky-config-row">
                                                    <span>Cache key</span>
                                                    <code>application session ID</code>
                                                    <small>Pin after the first completed response.</small>
                                                </div>
                                            }

                                            <div class="semantic-profile-editor">
                                                <div class="profile-editor-heading">
                                                    <strong>Owned profiles</strong>
                                                    <small>Demo keywords: @string.Join(", ", Draft.Families.Select(profile => profile.Name))</small>
                                                </div>
                                                @foreach (RouteFamilyDefinition profile in Draft.Families)
                                                {
                                                    <label class="semantic-profile-row">
                                                        <span>
                                                            <input type="radio"
                                                                   name="top-level-default-profile"
                                                                   checked="@profile.IsDefault"
                                                                   @onchange="() => MakeDefault(profile)" />
                                                            <strong>@profile.Name</strong>
                                                            @if (profile.IsDefault)
                                                            {
                                                                <small>default</small>
                                                            }
                                                        </span>
                                                        <textarea rows="2" @bind="profile.ProfileExamples"></textarea>
                                                    </label>
                                                }
                                            </div>
                                        }

                                        <label class="check-field">
                                            <input type="checkbox" @bind="Draft.GlobalFallbackEnabled" />
                                            <span>
                                                <strong>Outer emergency fallback</strong>
                                                <small>Use when the selected family is exhausted.</small>
                                            </span>
                                        </label>
                                    </div>
                                }
                                else if (SelectedSemanticRouter is { } semanticRouter &&
                                         SelectedFamily is { } semanticOwner)
                                {
                                    <div class="inspector-fields">
                                        <div class="inspector-grid three">
                                            <label>
                                                <span>Threshold</span>
                                                <input type="number" min="0" max="1" step="0.05"
                                                       @bind="semanticRouter.ScoreThreshold" />
                                            </label>
                                            <label>
                                                <span>Top K</span>
                                                <select @bind="semanticRouter.TopK">
                                                    <option value="1">1</option>
                                                    <option value="3">3</option>
                                                    <option value="5">5</option>
                                                </select>
                                            </label>
                                            <label>
                                                <span>Aggregation</span>
                                                <select @bind="semanticRouter.ScoreAggregation">
                                                    <option>Mean</option>
                                                    <option>Sum</option>
                                                </select>
                                            </label>
                                        </div>

                                        <div class="semantic-profile-editor">
                                            <div class="profile-editor-heading">
                                                <strong>Owned profiles</strong>
                                                <small>Demo keywords: @string.Join(", ", semanticRouter.Profiles.Select(profile => profile.Name))</small>
                                            </div>
                                            @foreach (RouteFamilyDefinition profile in semanticRouter.Profiles)
                                            {
                                                <label class="semantic-profile-row">
                                                    <span>
                                                        <input type="radio"
                                                               name="@($"inner-default-{semanticRouter.Id}")"
                                                               checked="@profile.IsDefault"
                                                               @onchange="() => MakeDefault(profile)" />
                                                        <strong>@profile.Name</strong>
                                                        @if (profile.IsDefault)
                                                        {
                                                            <small>default</small>
                                                        }
                                                    </span>
                                                    <textarea rows="2" @bind="profile.ProfileExamples"></textarea>
                                                </label>
                                            }
                                        </div>

                                        <div class="inspector-actions">
                                            <button class="button button-primary"
                                                    type="button"
                                                    @onclick="() => AddSemanticProfile(semanticOwner)">
                                                Add reasoning profile
                                            </button>
                                        </div>
                                    </div>
                                }
                                else if ((SelectedInnerFamily ?? SelectedFamily) is { } family &&
                                         SelectedRoute is null)
                                {
                                    bool ownsSemanticRouter = family.SemanticRouter is not null;
                                    <div class="inspector-fields">
                                        <div class="inspector-grid two">
                                            <label>
                                                <span>Family name</span>
                                                <input type="text" @bind="family.Name" />
                                            </label>
                                            <label>
                                                <span>Purpose</span>
                                                <input type="text" @bind="family.Purpose" />
                                            </label>
                                        </div>

                                        @if (ownsSemanticRouter)
                                        {
                                            <button class="semantic-target-card"
                                                    type="button"
                                                    @onclick="() => SelectSemanticRouter(family)">
                                                <span class="callout-glyph">SR</span>
                                                <span>
                                                    <strong>@family.SemanticRouter!.Name</strong>
                                                    <small>@family.SemanticRouter.Profiles.Count reasoning profiles</small>
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="field-group">
                                                <span class="field-label">Family resilience</span>
                                                <div class="segmented-control resilience-control">
                                                    @foreach (var option in ResilienceOptions)
                                                    {
                                                        bool optionDisabled =
                                                            option.Value == "None" && family.Routes.Count != 1;
                                                        <button type="button"
                                                                class="@(family.ResiliencePolicy == option.Value ? "selected" : null)"
                                                                disabled="@optionDisabled"
                                                                title="@(optionDisabled ? "Remove backup clients before selecting Single." : option.Description)"
                                                                @onclick="() => SetFamilyResilience(family, option.Value)">
                                                            @option.Label
                                                        </button>
                                                    }
                                                </div>
                                                <small class="field-help">@GetResilienceDescription(family.ResiliencePolicy)</small>
                                                @if (family.Routes.Count > 1)
                                                {
                                                    <small class="field-help constraint-help">
                                                        Single requires exactly one model client. Remove backups first.
                                                    </small>
                                                }
                                            </div>

                                            @if (family.ResiliencePolicy != "None")
                                            {
                                                <div class="inspector-grid two">
                                                    <label>
                                                        <span>Maximum attempts</span>
                                                        <select @bind="family.MaximumAttempts">
                                                            @for (var attempt = 1; attempt <= 6; attempt++)
                                                            {
                                                                <option value="@attempt">@attempt</option>
                                                            }
                                                        </select>
                                                    </label>
                                                    @if (family.ResiliencePolicy == "Cooldown")
                                                    {
                                                        <label>
                                                            <span>Cooldown</span>
                                                            <select @bind="family.CooldownSeconds">
                                                                <option value="10">10 seconds</option>
                                                                <option value="30">30 seconds</option>
                                                                <option value="60">60 seconds</option>
                                                            </select>
                                                        </label>
                                                    }
                                                </div>
                                            }
                                        }

                                        <div class="inspector-actions">
                                            @if (!ownsSemanticRouter)
                                            {
                                                <button class="button button-primary" type="button" @onclick="() => AddRoute(family)">
                                                    Add model client
                                                </button>
                                            }
                                            <button class="button button-quiet" type="button"
                                                    disabled="@IsFirstFamily(family)"
                                                    @onclick="() => MoveFamily(family, -1)">
                                                Move up
                                            </button>
                                            <button class="button button-quiet" type="button"
                                                    disabled="@IsLastFamily(family)"
                                                    @onclick="() => MoveFamily(family, 1)">
                                                Move down
                                            </button>
                                            <button class="button button-danger" type="button"
                                                    disabled="@(GetFamilyOwner(family).Count <= 1)"
                                                    @onclick="() => RemoveFamily(family)">
                                                Remove family
                                            </button>
                                        </div>
                                    </div>
                                }
                                else if (SelectedRoute is not null)
                                {
                                    RouteDefinition route = SelectedRoute;
                                    RouteFamilyDefinition? routeFamily = SelectedRouteFamily;
                                    bool isGlobal = SelectedNodeKey.StartsWith("global:", StringComparison.Ordinal);

                                    <div class="inspector-fields">
                                        @if (isGlobal)
                                        {
                                            <div class="inspector-callout warning">
                                                <span class="callout-glyph">GF</span>
                                                <div>
                                                    <strong>Outer fallback leaf</strong>
                                                    <p>Invoked only after the selected route-family client fails completely.</p>
                                                </div>
                                            </div>
                                        }

                                        <div class="inspector-grid two">
                                            <label>
                                                <span>Client name</span>
                                                <input type="text" @bind="route.Name" />
                                            </label>
                                            <label>
                                                <span>Purpose</span>
                                                <input type="text" @bind="route.Purpose" />
                                            </label>
                                        </div>

                                        <div class="inspector-grid two">
                                            <label>
                                                <span>Model ID</span>
                                                <select @bind="route.ModelId">
                                                    @foreach (string model in ModelOptions)
                                                    {
                                                        <option value="@model">@model</option>
                                                    }
                                                </select>
                                            </label>
                                            <label>
                                                <span>Max output tokens</span>
                                                <input type="number" min="64" max="16000" step="64"
                                                       @bind="route.MaxOutputTokens" />
                                            </label>
                                        </div>

                                        <div class="field-group">
                                            <span class="field-label">Reasoning effort</span>
                                            <div class="segmented-control">
                                                @foreach (string effort in ReasoningOptions)
                                                {
                                                    <button type="button"
                                                            class="@(route.ReasoningEffort == effort ? "selected" : null)"
                                                            @onclick="() => route.ReasoningEffort = effort">
                                                        @ToTitle(effort)
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        <label class="temperature-field inspector-temperature">
                                            <span>
                                                <span>Temperature</span>
                                                <strong>@route.Temperature.ToString("0.0")</strong>
                                            </span>
                                            <input type="range" min="0" max="1.5" step="0.1"
                                                   @bind="route.Temperature" @bind:event="oninput" />
                                        </label>

                                        <label>
                                            <span>Route instructions</span>
                                            <textarea rows="4" @bind="route.Instructions"></textarea>
                                        </label>

                                        @if (!isGlobal && routeFamily is not null)
                                        {
                                            <div class="inspector-actions">
                                                <button class="button button-quiet" type="button"
                                                        disabled="@IsFirstRoute(routeFamily, route)"
                                                        @onclick="() => MoveRoute(routeFamily, route, -1)">
                                                    Move up
                                                </button>
                                                <button class="button button-quiet" type="button"
                                                        disabled="@IsLastRoute(routeFamily, route)"
                                                        @onclick="() => MoveRoute(routeFamily, route, 1)">
                                                    Move down
                                                </button>
                                                <button class="button button-danger" type="button"
                                                        disabled="@(routeFamily.Routes.Count <= 1)"
                                                        @onclick="() => RemoveRoute(routeFamily, route)">
                                                    Remove client
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </section>
                        </div>

                <footer class="builder-actions live-builder-actions">
                    <div class="build-readiness">
                        <span class="readiness-dot @(CanBuild ? "ready" : null)"></span>
                        <span>
                            <strong>@(CanBuild ? "Pipeline ready" : "Pipeline needs attention")</strong>
                            <small>@Draft.Families.Count families / @Draft.AllRoutes().Count() model clients</small>
                        </span>
                    </div>

                    @{
                        List<string> liveWarnings = GetWarnings();
                    }
                    @if (liveWarnings.Count > 0)
                    {
                        <details class="live-review-notes">
                            <summary>@liveWarnings.Count review note@(liveWarnings.Count == 1 ? null : "s")</summary>
                            @foreach (string warning in liveWarnings)
                            {
                                <p>@warning</p>
                            }
                        </details>
                    }

                    <details class="live-code-preview">
                        <summary>C# shape</summary>
                        <pre><code>@BuildCodePreview(Draft)</code></pre>
                    </details>

                    <button class="button button-primary build-button" type="button"
                            disabled="@(!CanBuild)"
                            @onclick="BuildPipeline">
                        Build and start chat
                        <span>-&gt;</span>
                    </button>
                </footer>
            </section>
        </main>
    }
    else
    {
        <main class="workspace @(!PipelineSidebarVisible ? "pipeline-hidden" : null) @(!DebugSidebarVisible ? "debug-hidden" : null)">
            @if (PipelineSidebarVisible)
            {
                <aside class="pipeline-sidebar">
                    <section class="sidebar-section pipeline-tree-section">
                        <div class="sidebar-heading">
                            <span class="eyebrow">Active pipeline</span>
                            <div class="sidebar-heading-actions">
                                <span class="session-id">@SessionId</span>
                                <button class="sidebar-hide-button" type="button" @onclick="TogglePipelineSidebar">
                                    Hide
                                </button>
                            </div>
                        </div>
                        <div class="active-pipeline-tree">
                            <PipelineTree Configuration="ActiveConfiguration!"
                                          Interactive="true"
                                          PinnedFamilyId="@StickyPinnedFamilyId"
                                          @bind-SelectedNodeKey="ActiveSelectedNodeKey" />
                        </div>
                    </section>

                    @if (ActiveConfiguration!.SelectionPolicy == "StickySemantic")
                    {
                        <section class="sticky-session-card">
                            <span class="eyebrow">Session route</span>
                            <div>
                                <strong>@(StickyPinnedFamily?.Name ?? "Unpinned")</strong>
                                <small>@SessionId</small>
                            </div>
                            @if (StickyPinnedFamily is not null)
                            {
                                <button type="button" @onclick="ClearStickyPin">Clear pin</button>
                            }
                        </section>
                    }

                    <section class="sidebar-section selected-health-section">
                        <div class="sidebar-heading">
                            <span class="eyebrow">Model health</span>
                        </div>

                        @if (ActiveSelectedRouteLocation is { } selectedLocation)
                        {
                            RouteDefinition selectedRoute = selectedLocation.Route;
                            <article class="selected-health-card @GetRouteStatusClass(selectedRoute)">
                                <header>
                                    <span class="health-indicator"></span>
                                    <div>
                                        <strong>@selectedRoute.Name</strong>
                                        <small>@selectedLocation.FamilyName / @selectedRoute.ModelId</small>
                                    </div>
                                    <span class="health-label">@GetRouteStatusLabel(selectedRoute)</span>
                                </header>

                                <dl>
                                    <div>
                                        <dt>Availability</dt>
                                        <dd>@GetAvailabilityLabel(selectedRoute)</dd>
                                    </div>
                                    <div>
                                        <dt>Policy health</dt>
                                        <dd>@GetPolicyHealthLabel(selectedRoute)</dd>
                                    </div>
                                </dl>

                                <div class="selected-health-actions">
                                    @if (IsRouteUnavailable(selectedRoute) || IsRouteCoolingDown(selectedRoute))
                                    {
                                        <button type="button" @onclick="() => ReviveRoute(selectedRoute)">Revive</button>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="() => FailNext(selectedRoute)">Fail next</button>
                                        <button type="button" @onclick="() => KillFor(selectedRoute, 30)">Kill 30s</button>
                                        <button type="button" @onclick="() => KillUntilRevived(selectedRoute)">Kill until revive</button>
                                    }
                                </div>
                            </article>
                        }
                        else
                        {
                            <div class="selected-health-empty">
                                Select a model client in the tree.
                            </div>
                        }
                    </section>
                </aside>
            }

            <section class="chat-panel">
                <header class="chat-header">
                    <div>
                        <span class="eyebrow">Chat demo</span>
                        <h2>Ask the pipeline</h2>
                    </div>
                    <div class="chat-header-actions">
                        <div class="workspace-panel-toggles">
                            <button class="panel-toggle @(PipelineSidebarVisible ? "active" : null)"
                                    type="button"
                                    @onclick="TogglePipelineSidebar">
                                @(PipelineSidebarVisible ? "Hide pipeline" : "Show pipeline")
                            </button>
                            <button class="panel-toggle @(DebugSidebarVisible ? "active" : null)"
                                    type="button"
                                    @onclick="ToggleDebugSidebar">
                                @(DebugSidebarVisible ? "Hide debug" : "Show debug")
                            </button>
                        </div>
                        @if (Messages.Count > 0 && !IsSending)
                        {
                            <button class="clear-chat-button" type="button" @onclick="ClearTranscript">
                                Clear chat
                            </button>
                        }
                        <div class="chat-mode">
                            <span class="mode-dot"></span>
                            MEAI / Mock responses
                            <span>/</span>
                            @(ActiveConfiguration!.Streaming ? "Streaming" : "Non-streaming")
                        </div>
                    </div>
                </header>

                <div class="transcript">
                    @if (Messages.Count == 0)
                    {
                        <div class="chat-empty">
                            <div class="empty-orbit">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                            <h3>Send a message through the tree.</h3>
                            <p>Then kill a leaf model and watch its route family fail over internally.</p>
                            <div class="prompt-suggestions">
                                @foreach (string suggestion in PromptSuggestions)
                                {
                                    <button type="button" @onclick="() => UsePrompt(suggestion)">
                                        @suggestion
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (ChatEntry message in Messages)
                        {
                            <article class="message @message.Role">
                                <div class="message-avatar">@(message.Role == "user" ? "You" : "AI")</div>
                                <div class="message-content">
                                    <header>
                                        <strong>@(message.Role == "user" ? "You" : message.RouteName ?? "Router")</strong>
                                        @if (message.ModelId is not null)
                                        {
                                            <span>@message.ModelId</span>
                                        }
                                    </header>
                                    <p>@message.Content</p>
                                    @if (message.IsPending)
                                    {
                                        <span class="typing-indicator"><i></i><i></i><i></i></span>
                                    }
                                </div>
                            </article>
                        }
                    }
                </div>

                <footer class="composer">
                    <div class="composer-box">
                        <textarea rows="2"
                                  id="chat-composer"
                                  placeholder="Message the routing pipeline..."
                                  aria-label="Chat message"
                                  disabled="@IsSending"
                                  @bind="Prompt"
                                  @bind:event="oninput"></textarea>
                        <div class="composer-footer">
                            <span>Enter to send · Shift+Enter for newline</span>
                            @if (IsSending)
                            {
                                <button class="cancel-button" type="button" @onclick="CancelRequest">Cancel</button>
                            }
                            else
                            {
                                <button class="send-button" type="button"
                                        disabled="@string.IsNullOrWhiteSpace(Prompt)"
                                        @onclick="SendAsync"
                                        aria-label="Send message">
                                    Send
                                    <span>-&gt;</span>
                                </button>
                            }
                        </div>
                    </div>
                </footer>
            </section>

            @if (DebugSidebarVisible)
            {
                <aside class="debug-panel">
                <header class="debug-header">
                    <div>
                        <span class="eyebrow">Request inspector</span>
                        <h2>Debug</h2>
                    </div>
                    <div class="debug-header-actions">
                        @if (CurrentDebug is not null)
                        {
                            <span class="request-id">@CurrentDebug.RequestId</span>
                        }
                        <button class="sidebar-hide-button" type="button" @onclick="ToggleDebugSidebar">
                            Hide
                        </button>
                    </div>
                </header>

                <nav class="debug-tabs" aria-label="Debug views">
                    @foreach (string tab in DebugTabs)
                    {
                        <button class="@(DebugTab == tab ? "active" : null)"
                                type="button"
                                @onclick="() => DebugTab = tab">
                            @tab
                            @if (tab == "Attempts" && CurrentDebug?.Attempts.Count > 0)
                            {
                                <span>@CurrentDebug.Attempts.Count</span>
                            }
                        </button>
                    }
                </nav>

                <div class="debug-content">
                    @if (CurrentDebug is null)
                    {
                        <div class="debug-empty">
                            <span class="debug-empty-icon">_</span>
                            <strong>No request selected</strong>
                            <p>Send a chat message to populate selection and nested failover evidence.</p>
                        </div>
                    }
                    else if (DebugTab == "Summary")
                    {
                        <section class="debug-summary-card">
                            <div class="outcome-row">
                                <span class="outcome-dot @CurrentDebug.Outcome.ToLowerInvariant()"></span>
                                <div>
                                    <small>Outcome</small>
                                    <strong>@CurrentDebug.Outcome</strong>
                                </div>
                                <span class="finish-reason">@CurrentDebug.FinishReason</span>
                            </div>
                            <dl>
                                <div><dt>Selected family</dt><dd>@CurrentDebug.SelectedRoute</dd></div>
                                @if (CurrentDebug.SelectedInnerRoute != "Pending")
                                {
                                    <div><dt>Reasoning profile</dt><dd>@CurrentDebug.SelectedInnerRoute</dd></div>
                                }
                                <div><dt>Completed client</dt><dd>@CurrentDebug.FinalRoute</dd></div>
                                <div><dt>Family resilience</dt><dd>@CurrentDebug.ResiliencePolicy</dd></div>
                                <div><dt>Actual model</dt><dd>@CurrentDebug.ActualModel</dd></div>
                            </dl>
                            <div class="usage-row">
                                <span><strong>@CurrentDebug.InputTokens</strong> input</span>
                                <span><strong>@CurrentDebug.OutputTokens</strong> output</span>
                            </div>
                        </section>

                        @if (CurrentDebug.Scores.Count > 0)
                        {
                            <section class="debug-section">
                                <div class="debug-section-heading">
                                    <h3>Semantic family evidence</h3>
                                    <span>@CurrentDebug.Scores.Select(score => score.Layer).Distinct().Count() layer(s)</span>
                                </div>
                                @foreach (IGrouping<string, RoutingScore> scoreLayer in
                                    CurrentDebug.Scores.GroupBy(score => score.Layer))
                                {
                                    <div class="score-layer-label">@scoreLayer.Key</div>
                                    <div class="score-list">
                                        @foreach (RoutingScore score in scoreLayer.OrderByDescending(score => score.Score))
                                        {
                                            <div class="score-row">
                                                <div>
                                                    <strong>@score.RouteFamilyName</strong>
                                                    <small>@(string.IsNullOrWhiteSpace(score.MatchedTerms) ? "No direct terms" : score.MatchedTerms)</small>
                                                </div>
                                                <div class="score-meter">
                                                    <span style="width: @($"{Math.Clamp(score.Score, 0, 1) * 100:0}%")"></span>
                                                </div>
                                                <strong>@score.Score.ToString("0.00")</strong>
                                            </div>
                                        }
                                    </div>
                                }
                            </section>
                        }

                        <section class="debug-section">
                            <div class="debug-section-heading">
                                <h3>Event timeline</h3>
                                <button type="button" @onclick="ClearDebugEvents">Clear</button>
                            </div>
                            <div class="event-list">
                                @foreach (DebugEventRecord item in CurrentDebug.Events.AsEnumerable().Reverse())
                                {
                                    <div class="event-row">
                                        <span class="event-node @item.Kind.ToLowerInvariant()"></span>
                                        <div>
                                            <span class="event-time">@item.Timestamp.ToString("HH:mm:ss.fff")</span>
                                            <strong>@item.Title</strong>
                                            <p>@item.Detail</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                    else if (DebugTab == "Attempts")
                    {
                        <section class="debug-section attempts-section">
                            <div class="debug-section-heading">
                                <h3>Leaf client attempts</h3>
                                <span>@CurrentDebug.Attempts.Count total</span>
                            </div>
                            @if (CurrentDebug.Attempts.Count == 0)
                            {
                                <p class="muted-copy">No client invocation has completed yet.</p>
                            }
                            else
                            {
                                <div class="attempt-list">
                                    @foreach (AttemptRecord attempt in CurrentDebug.Attempts)
                                    {
                                        <article class="attempt-card @attempt.Status.ToLowerInvariant()">
                                            <header>
                                                <span class="attempt-number">@attempt.Number</span>
                                                <div>
                                                    <strong>@attempt.RouteName</strong>
                                                    <small>@attempt.Layer / @attempt.ModelId</small>
                                                </div>
                                                <span class="attempt-status">@attempt.Status</span>
                                            </header>
                                            <dl>
                                                <div><dt>Duration</dt><dd>@attempt.DurationMs ms</dd></div>
                                                <div><dt>TTFU</dt><dd>@(attempt.TimeToFirstUpdateMs is null ? "--" : $"{attempt.TimeToFirstUpdateMs} ms")</dd></div>
                                                <div><dt>Completed</dt><dd>@FormatBoolean(attempt.ResponseCompleted)</dd></div>
                                                <div><dt>Committed</dt><dd>@FormatBoolean(attempt.OutputCommitted)</dd></div>
                                                <div><dt>Terminal in layer</dt><dd>@FormatBoolean(attempt.IsTerminal)</dd></div>
                                            </dl>
                                            @if (attempt.Exception is not null)
                                            {
                                                <p class="attempt-exception">@attempt.Exception</p>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    }
                    else
                    {
                        <section class="debug-section options-section">
                            <div class="debug-section-heading">
                                <h3>Request options</h3>
                                <span>Cloned per attempt</span>
                            </div>
                            <div class="option-layer">
                                <span>Caller</span>
                                <dl>
                                    <div><dt>Streaming</dt><dd>@FormatBoolean(ActiveConfiguration.Streaming)</dd></div>
                                    <div><dt>Messages</dt><dd>@Messages.Count</dd></div>
                                    <div><dt>Selection</dt><dd>@ActiveConfiguration.SelectionPolicy</dd></div>
                                </dl>
                            </div>
                            <div class="layer-connector">+</div>
                            @{
                                RouteDefinition? effectiveRoute = FindRouteById(
                                    ActiveConfiguration,
                                    CurrentDebug.FinalRouteId);
                            }
                            <div class="option-layer accent">
                                <span>Leaf route wrapper</span>
                                @if (effectiveRoute is not null)
                                {
                                    <dl>
                                        <div><dt>Model</dt><dd>@effectiveRoute.ModelId</dd></div>
                                        <div><dt>Reasoning</dt><dd>@ToTitle(effectiveRoute.ReasoningEffort)</dd></div>
                                        <div><dt>Temperature</dt><dd>@effectiveRoute.Temperature.ToString("0.0")</dd></div>
                                        <div><dt>Max output</dt><dd>@effectiveRoute.MaxOutputTokens</dd></div>
                                    </dl>
                                    <p>@effectiveRoute.Instructions</p>
                                }
                                else
                                {
                                    <p>No leaf client completed the request.</p>
                                }
                            </div>

                            <details class="raw-config">
                                <summary>Pipeline shape</summary>
                                <pre><code>@BuildCodePreview(ActiveConfiguration)</code></pre>
                            </details>
                        </section>
                    }
                </div>
                </aside>
            }
        </main>
    }
</div>
