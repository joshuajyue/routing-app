@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using RoutingDemo.Web.Demo

<PageTitle>Routing AI Chat Demo</PageTitle>

<div class="demo-shell">
    <header class="topbar">
        <button class="brand" type="button" @onclick="GoHome" aria-label="Routing AI demo home">
            <span class="brand-mark">R</span>
            <span>
                <strong>routing.ai</strong>
                <small>Microsoft.Extensions.AI</small>
            </span>
        </button>

        @if (IsBuilt)
        {
            <div class="topbar-pipeline">
                <span class="live-dot"></span>
                <span>@ActiveConfiguration!.ScenarioName</span>
                <span class="topbar-separator">/</span>
                <span>@GetCompositionLabel(ActiveConfiguration)</span>
            </div>

            <button class="button button-quiet" type="button" @onclick="RebuildPipeline">
                Rebuild pipeline
            </button>
        }
        else
        {
            <span class="prototype-badge">Interactive prototype</span>
        }
    </header>

    @if (!IsBuilt)
    {
        <main class="builder-page">
            <section class="builder-intro">
                <div>
                    <span class="eyebrow">Extensible routing playground</span>
                    <h1>Compose the tree.<br />Then watch it route.</h1>
                </div>
                <p>
                    Semantic profiles can target individual models or complete
                    ordered and cooldown failover chains. Build the client tree,
                    then inspect it live in chat.
                </p>
            </section>

            <nav class="stepper" aria-label="Pipeline build steps">
                @for (var i = 0; i < BuilderSteps.Length; i++)
                {
                    var stepIndex = i;
                    <button class="step @(CurrentStep == i ? "active" : null) @(CurrentStep > i ? "complete" : null)"
                            type="button"
                            @onclick="() => GoToStep(stepIndex)"
                            disabled="@(i > CurrentStep)">
                        <span class="step-number">@(i + 1)</span>
                        <span>
                            <strong>@BuilderSteps[i].Title</strong>
                            <small>@BuilderSteps[i].Subtitle</small>
                        </span>
                    </button>
                }
            </nav>

            <section class="builder-card">
                @switch (CurrentStep)
                {
                    case 0:
                        <div class="section-heading">
                            <div>
                                <span class="eyebrow">Start with a shape</span>
                                <h2>Choose a composition</h2>
                            </div>
                            <p>Each scenario prefills an editable client tree.</p>
                        </div>

                        <div class="scenario-grid">
                            @foreach (ScenarioDefinition scenario in Scenarios)
                            {
                                <button class="scenario-card @(Draft.ScenarioId == scenario.Id ? "selected" : null)"
                                        type="button"
                                        @onclick="() => SelectScenario(scenario.Id)">
                                    <span class="scenario-topline">
                                        <span class="scenario-icon">@GetScenarioMonogram(scenario.Id)</span>
                                        @if (scenario.Id == "semantic-composition")
                                        {
                                            <span class="recommended-label">Recommended</span>
                                        }
                                    </span>
                                    <span class="scenario-eyebrow">@scenario.Eyebrow</span>
                                    <strong>@scenario.Name</strong>
                                    <span class="scenario-description">@scenario.Description</span>
                                    <span class="scenario-policies">
                                        <span>@scenario.SelectionPolicy</span>
                                        <span class="policy-arrow">-&gt;</span>
                                        <span>@scenario.Composition</span>
                                    </span>
                                </button>
                            }
                        </div>
                        break;

                    case 1:
                        <div class="section-heading">
                            <div>
                                <span class="eyebrow">Set the outer shape</span>
                                <h2>Choose selection and escape hatch</h2>
                            </div>
                            <p>
                                Resilience is configured inside each route family.
                                An optional outer fallback catches an exhausted family.
                            </p>
                        </div>

                        <div class="policy-section">
                            <div class="policy-section-header">
                                <span class="layer-number">01</span>
                                <div>
                                    <h3>Top-level selection</h3>
                                    <p>Which stable route-family client should receive the request?</p>
                                </div>
                            </div>
                            <div class="policy-options">
                                @foreach (var option in SelectionOptions)
                                {
                                    <button class="policy-option @(Draft.SelectionPolicy == option.Value ? "selected" : null)"
                                            type="button"
                                            @onclick="() => SetSelectionPolicy(option.Value)">
                                        <span class="radio-mark"></span>
                                        <span>
                                            <strong>@option.Label</strong>
                                            <small>@option.Description</small>
                                        </span>
                                    </button>
                                }
                            </div>

                            @if (Draft.SelectionPolicy == "Semantic")
                            {
                                <div class="inline-settings semantic-settings">
                                    <label>
                                        <span>Score threshold</span>
                                        <strong>@Draft.ScoreThreshold.ToString("0.00")</strong>
                                        <input type="range" min="0" max="1" step="0.05"
                                               @bind="Draft.ScoreThreshold" @bind:event="oninput" />
                                    </label>
                                    <label>
                                        <span>Top K</span>
                                        <select @bind="Draft.TopK">
                                            <option value="1">1</option>
                                            <option value="3">3</option>
                                            <option value="5">5</option>
                                        </select>
                                    </label>
                                    <label>
                                        <span>Aggregation</span>
                                        <select @bind="Draft.ScoreAggregation">
                                            <option>Mean</option>
                                            <option>Sum</option>
                                        </select>
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="policy-divider"></div>

                        <div class="policy-section">
                            <div class="policy-section-header">
                                <span class="layer-number">02</span>
                                <div>
                                    <h3>Whole-pipeline fallback</h3>
                                    <p>Wrap the selector in an outer ordered failover with one emergency client.</p>
                                </div>
                            </div>
                            <div class="outer-fallback-options">
                                <button class="outer-option @(!Draft.GlobalFallbackEnabled ? "selected" : null)"
                                        type="button"
                                        @onclick="() => SetGlobalFallback(false)">
                                    <span class="radio-mark"></span>
                                    <span>
                                        <strong>No outer fallback</strong>
                                        <small>An exhausted route family ends the request.</small>
                                    </span>
                                </button>
                                <button class="outer-option @(Draft.GlobalFallbackEnabled ? "selected" : null)"
                                        type="button"
                                        @onclick="() => SetGlobalFallback(true)">
                                    <span class="radio-mark"></span>
                                    <span>
                                        <strong>Emergency fallback</strong>
                                        <small>OrderedFailover[selector, global-emergency]</small>
                                    </span>
                                </button>
                            </div>
                            @if (Draft.GlobalFallbackEnabled)
                            {
                                <div class="outer-fallback-summary">
                                    <span class="route-dot emergency"></span>
                                    <div>
                                        <strong>@Draft.GlobalFallback.Name</strong>
                                        <small>@Draft.GlobalFallback.ModelId / edit this leaf in the tree</small>
                                    </div>
                                </div>
                            }
                        </div>
                        break;

                    case 2:
                        <div class="section-heading tree-step-heading">
                            <div>
                                <span class="eyebrow">Edit by node</span>
                                <h2>Compose the client tree</h2>
                            </div>
                            <button class="button button-secondary" type="button" @onclick="AddFamily">
                                Add route family
                            </button>
                        </div>

                        <div class="composition-editor">
                            <section class="tree-canvas">
                                <header class="tree-canvas-header">
                                    <div>
                                        <strong>Pipeline</strong>
                                        <small>Select a node to edit it</small>
                                    </div>
                                    <div class="tree-legend">
                                        <span><i class="legend-selector"></i>selector</span>
                                        <span><i class="legend-family"></i>profile</span>
                                        <span><i class="legend-model"></i>model</span>
                                    </div>
                                </header>

                                <div class="interactive-tree-scroll">
                                    <PipelineTree Configuration="Draft"
                                                  Interactive="true"
                                                  @bind-SelectedNodeKey="SelectedNodeKey" />
                                </div>

                                <footer class="tree-canvas-footer">
                                    <span>@Draft.Families.Count route families</span>
                                    <span>@Draft.AllRoutes().Count() model clients</span>
                                </footer>
                            </section>

                            <section class="node-inspector">
                                <header class="node-inspector-header">
                                    <span class="node-type-label">@GetSelectedNodeType()</span>
                                    <h3>@GetSelectedNodeTitle()</h3>
                                    <p>@GetSelectedNodeDescription()</p>
                                </header>

                                @if (SelectedNodeKey is "selector" or "outer")
                                {
                                    <div class="inspector-fields">
                                        <div class="inspector-callout">
                                            <span class="callout-glyph">@(Draft.SelectionPolicy == "Semantic" ? "SR" : Draft.SelectionPolicy == "Callback" ? "CB" : "DR")</span>
                                            <div>
                                                <strong>@GetSelectorTypeName(Draft)</strong>
                                                <p>
                                                    This node selects a route family. Each family is itself an
                                                    <code>IChatClient</code>, so its target can be a failover chain.
                                                </p>
                                            </div>
                                        </div>

                                        <label>
                                            <span>Selection policy</span>
                                            <select value="@Draft.SelectionPolicy"
                                                    @onchange="OnSelectionChanged">
                                                <option>Semantic</option>
                                                <option>Callback</option>
                                                <option>None</option>
                                            </select>
                                        </label>

                                        @if (Draft.SelectionPolicy == "Semantic")
                                        {
                                            <div class="inspector-grid three">
                                                <label>
                                                    <span>Threshold</span>
                                                    <input type="number" min="0" max="1" step="0.05"
                                                           @bind="Draft.ScoreThreshold" />
                                                </label>
                                                <label>
                                                    <span>Top K</span>
                                                    <select @bind="Draft.TopK">
                                                        <option value="1">1</option>
                                                        <option value="3">3</option>
                                                        <option value="5">5</option>
                                                    </select>
                                                </label>
                                                <label>
                                                    <span>Aggregation</span>
                                                    <select @bind="Draft.ScoreAggregation">
                                                        <option>Mean</option>
                                                        <option>Sum</option>
                                                    </select>
                                                </label>
                                            </div>
                                        }

                                        <label class="check-field">
                                            <input type="checkbox" @bind="Draft.GlobalFallbackEnabled" />
                                            <span>
                                                <strong>Outer emergency fallback</strong>
                                                <small>Wrap the selector and emergency client in OrderedFailoverChatClient.</small>
                                            </span>
                                        </label>
                                    </div>
                                }
                                else if (SelectedFamily is not null && SelectedRoute is null)
                                {
                                    RouteFamilyDefinition family = SelectedFamily;
                                    <div class="inspector-fields">
                                        <div class="inspector-grid two">
                                            <label>
                                                <span>Family name</span>
                                                <input type="text" @bind="family.Name" />
                                            </label>
                                            <label>
                                                <span>Purpose</span>
                                                <input type="text" @bind="family.Purpose" />
                                            </label>
                                        </div>

                                        @if (Draft.SelectionPolicy == "Semantic")
                                        {
                                            <label>
                                                <span>Semantic profile examples <small>comma separated</small></span>
                                                <textarea rows="3" @bind="family.ProfileExamples"></textarea>
                                            </label>

                                            <label class="check-field">
                                                <input type="radio"
                                                       name="default-family"
                                                       checked="@family.IsDefault"
                                                       @onchange="() => MakeDefault(family)" />
                                                <span>
                                                    <strong>Default semantic family</strong>
                                                    <small>Selected when no profile clears the threshold.</small>
                                                </span>
                                            </label>
                                        }

                                        <div class="field-group">
                                            <span class="field-label">Family resilience</span>
                                            <div class="segmented-control resilience-control">
                                                @foreach (var option in ResilienceOptions)
                                                {
                                                    <button type="button"
                                                            class="@(family.ResiliencePolicy == option.Value ? "selected" : null)"
                                                            @onclick="() => SetFamilyResilience(family, option.Value)">
                                                        @option.Label
                                                    </button>
                                                }
                                            </div>
                                            <small class="field-help">@GetResilienceDescription(family.ResiliencePolicy)</small>
                                        </div>

                                        @if (family.ResiliencePolicy != "None")
                                        {
                                            <div class="inspector-grid two">
                                                <label>
                                                    <span>Maximum attempts</span>
                                                    <select @bind="family.MaximumAttempts">
                                                        @for (var attempt = 1; attempt <= 6; attempt++)
                                                        {
                                                            <option value="@attempt">@attempt</option>
                                                        }
                                                    </select>
                                                </label>
                                                @if (family.ResiliencePolicy == "Cooldown")
                                                {
                                                    <label>
                                                        <span>Cooldown</span>
                                                        <select @bind="family.CooldownSeconds">
                                                            <option value="10">10 seconds</option>
                                                            <option value="30">30 seconds</option>
                                                            <option value="60">60 seconds</option>
                                                        </select>
                                                    </label>
                                                }
                                            </div>
                                        }

                                        <div class="inspector-actions">
                                            <button class="button button-primary" type="button" @onclick="() => AddRoute(family)">
                                                Add model client
                                            </button>
                                            <button class="button button-quiet" type="button"
                                                    disabled="@IsFirstFamily(family)"
                                                    @onclick="() => MoveFamily(family, -1)">
                                                Move up
                                            </button>
                                            <button class="button button-quiet" type="button"
                                                    disabled="@IsLastFamily(family)"
                                                    @onclick="() => MoveFamily(family, 1)">
                                                Move down
                                            </button>
                                            <button class="button button-danger" type="button"
                                                    disabled="@(Draft.Families.Count <= 1)"
                                                    @onclick="() => RemoveFamily(family)">
                                                Remove family
                                            </button>
                                        </div>
                                    </div>
                                }
                                else if (SelectedRoute is not null)
                                {
                                    RouteDefinition route = SelectedRoute;
                                    RouteFamilyDefinition? family = SelectedRouteFamily;
                                    bool isGlobal = SelectedNodeKey.StartsWith("global:", StringComparison.Ordinal);

                                    <div class="inspector-fields">
                                        @if (isGlobal)
                                        {
                                            <div class="inspector-callout warning">
                                                <span class="callout-glyph">GF</span>
                                                <div>
                                                    <strong>Outer fallback leaf</strong>
                                                    <p>Invoked only after the selected route-family client fails completely.</p>
                                                </div>
                                            </div>
                                        }

                                        <div class="inspector-grid two">
                                            <label>
                                                <span>Client name</span>
                                                <input type="text" @bind="route.Name" />
                                            </label>
                                            <label>
                                                <span>Purpose</span>
                                                <input type="text" @bind="route.Purpose" />
                                            </label>
                                        </div>

                                        <div class="inspector-grid two">
                                            <label>
                                                <span>OpenAI model</span>
                                                <select @bind="route.ModelId">
                                                    @foreach (string model in ModelOptions)
                                                    {
                                                        <option value="@model">@model</option>
                                                    }
                                                </select>
                                            </label>
                                            <label>
                                                <span>Max output tokens</span>
                                                <input type="number" min="64" max="16000" step="64"
                                                       @bind="route.MaxOutputTokens" />
                                            </label>
                                        </div>

                                        <div class="field-group">
                                            <span class="field-label">Reasoning effort</span>
                                            <div class="segmented-control">
                                                @foreach (string effort in ReasoningOptions)
                                                {
                                                    <button type="button"
                                                            class="@(route.ReasoningEffort == effort ? "selected" : null)"
                                                            @onclick="() => route.ReasoningEffort = effort">
                                                        @ToTitle(effort)
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        <label class="temperature-field inspector-temperature">
                                            <span>
                                                <span>Temperature</span>
                                                <strong>@route.Temperature.ToString("0.0")</strong>
                                            </span>
                                            <input type="range" min="0" max="1.5" step="0.1"
                                                   @bind="route.Temperature" @bind:event="oninput" />
                                        </label>

                                        <label>
                                            <span>Route instructions</span>
                                            <textarea rows="4" @bind="route.Instructions"></textarea>
                                        </label>

                                        @if (!isGlobal && family is not null)
                                        {
                                            <div class="inspector-actions">
                                                <button class="button button-quiet" type="button"
                                                        disabled="@IsFirstRoute(family, route)"
                                                        @onclick="() => MoveRoute(family, route, -1)">
                                                    Move up
                                                </button>
                                                <button class="button button-quiet" type="button"
                                                        disabled="@IsLastRoute(family, route)"
                                                        @onclick="() => MoveRoute(family, route, 1)">
                                                    Move down
                                                </button>
                                                <button class="button button-danger" type="button"
                                                        disabled="@(family.Routes.Count <= 1)"
                                                        @onclick="() => RemoveRoute(family, route)">
                                                    Remove client
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </section>
                        </div>
                        break;

                    case 3:
                        <div class="section-heading review-heading">
                            <div>
                                <span class="eyebrow">Ready to instantiate</span>
                                <h2>Review the composed pipeline</h2>
                            </div>
                            <label class="streaming-toggle">
                                <input type="checkbox" @bind="Draft.Streaming" />
                                <span class="toggle-track"><span></span></span>
                                <span>
                                    <strong>Streaming responses</strong>
                                    <small>Expose output commitment and time to first update.</small>
                                </span>
                            </label>
                        </div>

                        <div class="review-grid composition-review-grid">
                            <div class="review-column">
                                <div class="review-panel pipeline-preview composition-preview">
                                    <header>
                                        <span>Pipeline graph</span>
                                        <span class="valid-badge">@(CanBuild ? "Valid" : "Needs attention")</span>
                                    </header>
                                    <PipelineTree Configuration="Draft" />
                                </div>

                                @if (GetWarnings().Count > 0)
                                {
                                    <div class="warning-panel">
                                        <strong>Review notes</strong>
                                        @foreach (string warning in GetWarnings())
                                        {
                                            <p>@warning</p>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="review-column">
                                <div class="review-panel summary-panel">
                                    <header><span>Configuration</span></header>
                                    <dl>
                                        <div><dt>Selection</dt><dd>@Draft.SelectionPolicy</dd></div>
                                        <div><dt>Route families</dt><dd>@Draft.Families.Count</dd></div>
                                        <div><dt>Model clients</dt><dd>@Draft.AllRoutes().Count()</dd></div>
                                        <div><dt>Outer fallback</dt><dd>@(Draft.GlobalFallbackEnabled ? Draft.GlobalFallback.Name : "None")</dd></div>
                                        @if (Draft.SelectionPolicy == "Semantic")
                                        {
                                            <div><dt>Semantic scoring</dt><dd>Top @Draft.TopK / @Draft.ScoreAggregation / @Draft.ScoreThreshold.ToString("0.00")</dd></div>
                                        }
                                    </dl>
                                </div>

                                <div class="family-summary-list">
                                    @foreach (RouteFamilyDefinition family in Draft.Families)
                                    {
                                        <article>
                                            <div>
                                                <strong>@family.Name</strong>
                                                <small>@family.Purpose</small>
                                            </div>
                                            <span>@family.ResiliencePolicy / @family.Routes.Count clients</span>
                                        </article>
                                    }
                                </div>

                                <details class="code-preview">
                                    <summary>Equivalent C# shape</summary>
                                    <pre><code>@BuildCodePreview(Draft)</code></pre>
                                </details>
                            </div>
                        </div>
                        break;
                }

                <footer class="builder-actions">
                    <button class="button button-quiet" type="button"
                            disabled="@(CurrentStep == 0)"
                            @onclick="PreviousStep">
                        Back
                    </button>
                    <span class="step-context">Step @(CurrentStep + 1) of @BuilderSteps.Length</span>
                    @if (CurrentStep < BuilderSteps.Length - 1)
                    {
                        <button class="button button-primary" type="button"
                                disabled="@(!CanAdvance)"
                                @onclick="NextStep">
                            Continue
                        </button>
                    }
                    else
                    {
                        <button class="button button-primary build-button" type="button"
                                disabled="@(!CanBuild)"
                                @onclick="BuildPipeline">
                            Build and start chat
                            <span>-&gt;</span>
                        </button>
                    }
                </footer>
            </section>
        </main>
    }
    else
    {
        <main class="workspace">
            <aside class="pipeline-sidebar">
                <section class="sidebar-section">
                    <div class="sidebar-heading">
                        <span class="eyebrow">Active pipeline</span>
                        <span class="session-id">@SessionId</span>
                    </div>
                    <div class="compact-pipeline">
                        <PipelineTree Configuration="ActiveConfiguration!" Compact="true" />
                    </div>
                </section>

                <section class="sidebar-section models-section">
                    <div class="sidebar-heading">
                        <span class="eyebrow">Model health</span>
                        <span class="model-count">@ActiveConfiguration!.AllRoutes().Count() clients</span>
                    </div>

                    <div class="health-list">
                        @foreach (RouteLocation location in GetRouteLocations(ActiveConfiguration))
                        {
                            RouteDefinition route = location.Route;
                            <article class="health-card @GetRouteStatusClass(route)" @key="route.Id">
                                <div class="health-card-main">
                                    <span class="health-indicator"></span>
                                    <div>
                                        <strong>@route.Name</strong>
                                        <small>@location.FamilyName / @route.ModelId</small>
                                    </div>
                                    <span class="health-label">@GetRouteStatusLabel(route)</span>
                                </div>

                                <div class="health-actions">
                                    @if (IsRouteUnavailable(route) || IsRouteCoolingDown(route))
                                    {
                                        <button type="button" @onclick="() => ReviveRoute(route)">Revive</button>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="() => FailNext(route)">Fail next</button>
                                        <button type="button" @onclick="() => KillFor(route, 30)">Kill 30s</button>
                                        <button type="button" @onclick="() => KillUntilRevived(route)">Kill until revive</button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>

                <section class="sidebar-note">
                    <span class="note-icon">i</span>
                    <p>
                        A semantic profile selects a stable family client. Ordered or cooldown
                        behavior then runs inside that family.
                    </p>
                </section>
            </aside>

            <section class="chat-panel">
                <header class="chat-header">
                    <div>
                        <span class="eyebrow">Chat demo</span>
                        <h2>Ask the pipeline</h2>
                    </div>
                    <div class="chat-header-actions">
                        @if (Messages.Count > 0 && !IsSending)
                        {
                            <button class="clear-chat-button" type="button" @onclick="ClearTranscript">
                                Clear chat
                            </button>
                        }
                        <div class="chat-mode">
                            <span class="mode-dot"></span>
                            Simulated OpenAI
                            <span>/</span>
                            @(ActiveConfiguration.Streaming ? "Streaming" : "Non-streaming")
                        </div>
                    </div>
                </header>

                <div class="transcript">
                    @if (Messages.Count == 0)
                    {
                        <div class="chat-empty">
                            <div class="empty-orbit">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                            <h3>Send a message through the tree.</h3>
                            <p>Then kill a leaf model and watch its route family fail over internally.</p>
                            <div class="prompt-suggestions">
                                @foreach (string suggestion in PromptSuggestions)
                                {
                                    <button type="button" @onclick="() => UsePrompt(suggestion)">
                                        @suggestion
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (ChatEntry message in Messages)
                        {
                            <article class="message @message.Role">
                                <div class="message-avatar">@(message.Role == "user" ? "You" : "AI")</div>
                                <div class="message-content">
                                    <header>
                                        <strong>@(message.Role == "user" ? "You" : message.RouteName ?? "Router")</strong>
                                        @if (message.ModelId is not null)
                                        {
                                            <span>@message.ModelId</span>
                                        }
                                    </header>
                                    <p>@message.Content</p>
                                    @if (message.IsPending)
                                    {
                                        <span class="typing-indicator"><i></i><i></i><i></i></span>
                                    }
                                </div>
                            </article>
                        }
                    }
                </div>

                <footer class="composer">
                    <div class="composer-box">
                        <textarea rows="2"
                                  placeholder="Message the routing pipeline..."
                                  aria-label="Chat message"
                                  disabled="@IsSending"
                                  @bind="Prompt"
                                  @bind:event="oninput"></textarea>
                        <div class="composer-footer">
                            <span>Inspect semantic selection, inner attempts, and outer fallback.</span>
                            @if (IsSending)
                            {
                                <button class="cancel-button" type="button" @onclick="CancelRequest">Cancel</button>
                            }
                            else
                            {
                                <button class="send-button" type="button"
                                        disabled="@string.IsNullOrWhiteSpace(Prompt)"
                                        @onclick="SendAsync"
                                        aria-label="Send message">
                                    Send
                                    <span>-&gt;</span>
                                </button>
                            }
                        </div>
                    </div>
                </footer>
            </section>

            <aside class="debug-panel">
                <header class="debug-header">
                    <div>
                        <span class="eyebrow">Request inspector</span>
                        <h2>Debug</h2>
                    </div>
                    @if (CurrentDebug is not null)
                    {
                        <span class="request-id">@CurrentDebug.RequestId</span>
                    }
                </header>

                <nav class="debug-tabs" aria-label="Debug views">
                    @foreach (string tab in DebugTabs)
                    {
                        <button class="@(DebugTab == tab ? "active" : null)"
                                type="button"
                                @onclick="() => DebugTab = tab">
                            @tab
                            @if (tab == "Attempts" && CurrentDebug?.Attempts.Count > 0)
                            {
                                <span>@CurrentDebug.Attempts.Count</span>
                            }
                        </button>
                    }
                </nav>

                <div class="debug-content">
                    @if (CurrentDebug is null)
                    {
                        <div class="debug-empty">
                            <span class="debug-empty-icon">_</span>
                            <strong>No request selected</strong>
                            <p>Send a chat message to populate selection and nested failover evidence.</p>
                        </div>
                    }
                    else if (DebugTab == "Summary")
                    {
                        <section class="debug-summary-card">
                            <div class="outcome-row">
                                <span class="outcome-dot @CurrentDebug.Outcome.ToLowerInvariant()"></span>
                                <div>
                                    <small>Outcome</small>
                                    <strong>@CurrentDebug.Outcome</strong>
                                </div>
                                <span class="finish-reason">@CurrentDebug.FinishReason</span>
                            </div>
                            <dl>
                                <div><dt>Selected family</dt><dd>@CurrentDebug.SelectedRoute</dd></div>
                                <div><dt>Completed client</dt><dd>@CurrentDebug.FinalRoute</dd></div>
                                <div><dt>Family resilience</dt><dd>@CurrentDebug.ResiliencePolicy</dd></div>
                                <div><dt>Actual model</dt><dd>@CurrentDebug.ActualModel</dd></div>
                            </dl>
                            <div class="usage-row">
                                <span><strong>@CurrentDebug.InputTokens</strong> input</span>
                                <span><strong>@CurrentDebug.OutputTokens</strong> output</span>
                            </div>
                        </section>

                        @if (CurrentDebug.Scores.Count > 0)
                        {
                            <section class="debug-section">
                                <div class="debug-section-heading">
                                    <h3>Semantic family evidence</h3>
                                    <span>@ActiveConfiguration.ScoreAggregation / top @ActiveConfiguration.TopK</span>
                                </div>
                                <div class="score-list">
                                    @foreach (RoutingScore score in CurrentDebug.Scores.OrderByDescending(score => score.Score))
                                    {
                                        <div class="score-row">
                                            <div>
                                                <strong>@score.RouteFamilyName</strong>
                                                <small>@(string.IsNullOrWhiteSpace(score.MatchedTerms) ? "No direct terms" : score.MatchedTerms)</small>
                                            </div>
                                            <div class="score-meter">
                                                <span style="width: @($"{Math.Clamp(score.Score, 0, 1) * 100:0}%")"></span>
                                            </div>
                                            <strong>@score.Score.ToString("0.00")</strong>
                                        </div>
                                    }
                                </div>
                                <p class="threshold-note">Threshold @ActiveConfiguration.ScoreThreshold.ToString("0.00")</p>
                            </section>
                        }

                        <section class="debug-section">
                            <div class="debug-section-heading">
                                <h3>Event timeline</h3>
                                <button type="button" @onclick="ClearDebugEvents">Clear</button>
                            </div>
                            <div class="event-list">
                                @foreach (DebugEventRecord item in CurrentDebug.Events.AsEnumerable().Reverse())
                                {
                                    <div class="event-row">
                                        <span class="event-node @item.Kind.ToLowerInvariant()"></span>
                                        <div>
                                            <span class="event-time">@item.Timestamp.ToString("HH:mm:ss.fff")</span>
                                            <strong>@item.Title</strong>
                                            <p>@item.Detail</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                    else if (DebugTab == "Attempts")
                    {
                        <section class="debug-section attempts-section">
                            <div class="debug-section-heading">
                                <h3>Leaf client attempts</h3>
                                <span>@CurrentDebug.Attempts.Count total</span>
                            </div>
                            @if (CurrentDebug.Attempts.Count == 0)
                            {
                                <p class="muted-copy">No client invocation has completed yet.</p>
                            }
                            else
                            {
                                <div class="attempt-list">
                                    @foreach (AttemptRecord attempt in CurrentDebug.Attempts)
                                    {
                                        <article class="attempt-card @attempt.Status.ToLowerInvariant()">
                                            <header>
                                                <span class="attempt-number">@attempt.Number</span>
                                                <div>
                                                    <strong>@attempt.RouteName</strong>
                                                    <small>@attempt.Layer / @attempt.ModelId</small>
                                                </div>
                                                <span class="attempt-status">@attempt.Status</span>
                                            </header>
                                            <dl>
                                                <div><dt>Duration</dt><dd>@attempt.DurationMs ms</dd></div>
                                                <div><dt>TTFU</dt><dd>@(attempt.TimeToFirstUpdateMs is null ? "--" : $"{attempt.TimeToFirstUpdateMs} ms")</dd></div>
                                                <div><dt>Completed</dt><dd>@FormatBoolean(attempt.ResponseCompleted)</dd></div>
                                                <div><dt>Committed</dt><dd>@FormatBoolean(attempt.OutputCommitted)</dd></div>
                                                <div><dt>Terminal in layer</dt><dd>@FormatBoolean(attempt.IsTerminal)</dd></div>
                                            </dl>
                                            @if (attempt.Exception is not null)
                                            {
                                                <p class="attempt-exception">@attempt.Exception</p>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    }
                    else
                    {
                        <section class="debug-section options-section">
                            <div class="debug-section-heading">
                                <h3>Request options</h3>
                                <span>Cloned per attempt</span>
                            </div>
                            <div class="option-layer">
                                <span>Caller</span>
                                <dl>
                                    <div><dt>Streaming</dt><dd>@FormatBoolean(ActiveConfiguration.Streaming)</dd></div>
                                    <div><dt>Messages</dt><dd>@Messages.Count</dd></div>
                                    <div><dt>Selection</dt><dd>@ActiveConfiguration.SelectionPolicy</dd></div>
                                </dl>
                            </div>
                            <div class="layer-connector">+</div>
                            @{
                                RouteDefinition? effectiveRoute = FindRouteById(
                                    ActiveConfiguration,
                                    CurrentDebug.FinalRouteId);
                            }
                            <div class="option-layer accent">
                                <span>Leaf route wrapper</span>
                                @if (effectiveRoute is not null)
                                {
                                    <dl>
                                        <div><dt>Model</dt><dd>@effectiveRoute.ModelId</dd></div>
                                        <div><dt>Reasoning</dt><dd>@ToTitle(effectiveRoute.ReasoningEffort)</dd></div>
                                        <div><dt>Temperature</dt><dd>@effectiveRoute.Temperature.ToString("0.0")</dd></div>
                                        <div><dt>Max output</dt><dd>@effectiveRoute.MaxOutputTokens</dd></div>
                                    </dl>
                                    <p>@effectiveRoute.Instructions</p>
                                }
                                else
                                {
                                    <p>No leaf client completed the request.</p>
                                }
                            </div>

                            <details class="raw-config">
                                <summary>Pipeline shape</summary>
                                <pre><code>@BuildCodePreview(ActiveConfiguration)</code></pre>
                            </details>
                        </section>
                    }
                </div>
            </aside>
        </main>
    }
</div>
